APP_NAME="Lintune Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lintune
DB_USERNAME=<db_user>
DB_PASSWORD=<db_password>

SESSION_DRIVER=database
SESSION_LIFETIME=120

KEYCLOAK_BASE_URL=https://auth.yourdomain.com
KEYCLOAK_CLIENT_ID=lintune-frontend
KEYCLOAK_ADMIN_CLI_CLIENT=admin-cli
