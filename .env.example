APP_NAME="Lintune Admin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lintune
DB_USERNAME=<db_user>
DB_PASSWORD=<db_password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

KEYCLOAK_BASE_URL=https://auth.yourdomain.com
KEYCLOAK_CLIENT_ID=lintune-frontend
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_BROKER_REALM=
FRONTEND_URL=https://dash.yourdomain.com

MAILCOW_URL=https://mail.yourdomain.com
MAILCOW_API_KEY=<mailcow_api_key>

# Set automatically by /setup — do not edit manually
SETUP_COMPLETE=
